# ─── AIVista configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in the keys you have.
# With no keys at all, the app still runs fully in DEMO mode.

API_PORT=3001

# SQLite database file (local). For Turso later: libsql://<db>.turso.io
DATABASE_URL=file:data/aivista.db
# DATABASE_AUTH_TOKEN=

# ─── "Brain" LLM: query generation, analysis, diagnosis, recommendations ──
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Also test queries against Gemini with Google Search grounding (real citations)
GEMINI_GROUNDED_TESTING=true

# ─── AI search testing: free LLM providers (add any you have) ─────────────
# https://openrouter.ai/keys — free models are discovered automatically (":free")
OPENROUTER_API_KEY=
OPENROUTER_MAX_MODELS=10

# https://console.groq.com/keys
GROQ_API_KEY=

# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# https://console.mistral.ai
MISTRAL_API_KEY=

# GitHub personal access token with "models:read" — https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=

# Max pages crawled during website investigation
CRAWL_MAX_PAGES=20
# Render JavaScript-heavy pages in headless Chromium (needs: npx playwright install chromium)
CRAWL_JS_FALLBACK=true

# ─── Accounts ─────────────────────────────────────────────────────────────
# Set to false after creating your accounts to stop strangers signing up on a public deploy
ALLOW_SIGNUP=true
