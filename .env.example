# ─── AIVista configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in the keys you have.
# With no keys at all, the app still runs fully in DEMO mode.

API_PORT=3001

# SQLite database file (local). For Turso later: libsql://<db>.turso.io
DATABASE_URL=file:data/aivista.db
# DATABASE_AUTH_TOKEN=

# ─── "Brain" LLM: query generation, analysis, diagnosis, recommendations ──
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Also test queries against Gemini with Google Search grounding (real citations).
# Off by default: Gemini is the "brain"; the 3 testers below are the AI assistants under test.
GEMINI_GROUNDED_TESTING=false

# Customer queries generated per analysis, and AI assistants each one is tested against
QUERY_COUNT=7
TEST_MODEL_COUNT=3

# ─── AI search testing: 3 free LLMs, one per provider (no card needed) ────
# Pin a specific model with <PROVIDER>_MODEL, e.g. GROQ_MODEL=qwen/qwen3.8-27b
# Tester 1 — https://console.groq.com/keys — default model: GPT-OSS 120B
GROQ_API_KEY=

# Tester 2 — https://console.mistral.ai (choose the free "Experiment" plan) — default model: Mistral Small
MISTRAL_API_KEY=

# Tester 3 — https://dashboard.cohere.com/api-keys (Trial key) — default model: Command A
COHERE_API_KEY=

# Optional extra providers (used only if you raise TEST_MODEL_COUNT or a tester above is missing):
# CEREBRAS_API_KEY=
# NVIDIA_API_KEY=
# GITHUB_MODELS_TOKEN=

# Max pages crawled during website investigation
CRAWL_MAX_PAGES=20
# Render JavaScript-heavy pages in headless Chromium (needs: npx playwright install chromium)
CRAWL_JS_FALLBACK=true

# ─── Accounts ─────────────────────────────────────────────────────────────
# Off by default: no sign-in page, everyone with the link shares one workspace.
# Set to true to require email/password accounts (each with its own workspace).
REQUIRE_LOGIN=false
# Only used when REQUIRE_LOGIN=true. Set to false after creating your accounts.
ALLOW_SIGNUP=true
